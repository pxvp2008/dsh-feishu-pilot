{
  "name": "dsh-feishu-pilot",
  "version": "1.0.1",
  "description": "扫码即把飞书变成 DSH 的远程控制台：桌面 GUI 会话的任务、审批和提问可在手机上继续，任务结束主动通知，GUI 与飞书双端同时受理，离开电脑也不停。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "assets",
    "locale",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "icon": "assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "remote-control",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
